# 复制为 .env 后按需修改：cp .env.example .env

# Django
SECRET_KEY=change-me-to-a-random-long-string
DEBUG=false
ALLOWED_HOSTS=*

# MySQL（mysql 容器）
MYSQL_ROOT_PASSWORD=root123
DB_NAME=jifang
DB_USER=jifang
DB_PASSWORD=jifang123

# 首次启动是否生成演示数据（admin/admin、teacher/teacher、student/student）
INIT_DEMO=true

# 前端对外端口（浏览器访问 http://服务器IP:8080）
WEB_PORT=8080
